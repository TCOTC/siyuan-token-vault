{
  "name": "siyuan-token-vault",
  "version": "0.1.0",
  "description": "SiYuan 插件共用加密 Token 存储：设备特征种子 + PBKDF2 + AES-GCM，密文版本化落盘",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --cache",
    "lint:fix": "eslint . --fix --cache",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "siyuan",
    "plugin",
    "token",
    "vault",
    "encryption"
  ],
  "author": "Jeffrey Chen",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.9.1",
    "globals": "^17.12.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^5.0.0"
  }
}
